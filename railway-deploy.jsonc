{
  "$schema": "https://raw.githubusercontent.com/Slopshop-Tools/slopshop-railway-deploy-action/main/dist/schema.json",
  "version": 1,

  "project": {
    "name": "nc-cardinal-manga"
  },

  "databases": [
    { "name": "postgres", "type": "postgres" }
  ],

  "services": [
    {
      "name": "api",
      "root": "apps/api",
      "variables": {
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "NODE_ENV": "production"
      }
    }
  ]
}
